# =============================================================================
# TRADING RESEARCH SYSTEM CONFIGURATION
# =============================================================================

# =============================================================================
# INFOWAY API CONFIGURATION
# =============================================================================
# Get your API key from: https://infoway.io/
# This is the primary data source for forex, metals, and stocks

INFOWAY_API_KEY=your_infoway_api_key_here
INFOWAY_COMMON_API_KEY=your_infoway_common_api_key_here
INFOWAY_STOCK_API_KEY=your_infoway_stock_api_key_here

# Optional: Use HTTP(S)_PROXY / ALL_PROXY env vars for InfoWay
INFOWAY_TRUST_ENV_PROXY=false

# Optional: Enable/disable WebSocket streaming
INFOWAY_WS_COMMON=true  # Enable for forex/metals (default: true)
INFOWAY_WS_STOCK=false  # Enable for stocks (default: false due to limits)

# REST refresh cadence when WS is OFF/disconnected (seconds)
# Leave empty to use per-TF defaults (1m=15s, 5m=30s, 15m=60s, 1h=300s, 4h=900s, 1d=3600s)
INFOWAY_REST_REFRESH_S=

# Rate limiting (requests per second)
# Free tier: 1, Pro tier: 10, Enterprise: higher
INFOWAY_MAX_RPS=1

# Historical data settings
INFOWAY_HIST_KLINE_NUM=500  # Bars per request (max 500)
INFOWAY_HIST_MAX_PAGES=250  # Max pages for historical data

# Timeout settings
INFOWAY_TIMEOUT_S=30

# =============================================================================
# BINANCE API CONFIGURATION (Crypto)
# =============================================================================
# Recommended for public market data: https://data-api.binance.vision
# If Binance is blocked on your network, point to a reachable proxy/mirror

BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_SSL_VERIFY=true
BINANCE_CONNECT_TIMEOUT_S=4
BINANCE_LIVE_ENABLED=true

# =============================================================================
# DATA CACHE CONFIGURATION
# =============================================================================
# Directory for storing cached market data
CACHE_DIR=./data/cache

# =============================================================================
# BACKTESTING CONFIGURATION
# =============================================================================
# Default backtesting period (days)
DEFAULT_BACKTEST_DAYS=365

# Initial capital for backtesting
BACKTEST_INITIAL_CAPITAL=100000

# Commission rate (0.0 for no commission)
BACKTEST_COMMISSION=0.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (empty for stdout only)
LOG_FILE=

# =============================================================================
# TELEGRAM BOT CONFIGURATION (Optional)
# =============================================================================
# Only needed if you want to run the Telegram bot interface
TELEGRAM_TOKEN=your_telegram_bot_token_here
ALLOWED_USERNAMES=your_telegram_username

# =============================================================================
# AI PROVIDER CONFIGURATION (Optional)
# =============================================================================
# AI provider for strategy analysis and optimization
# Options: gemini, glm
AI_PROVIDER=glm

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Connection pool sizes and timeouts
TELEGRAM_CONNECTION_POOL_SIZE=4
TELEGRAM_CONNECT_TIMEOUT_S=60
TELEGRAM_READ_TIMEOUT_S=60
TELEGRAM_WRITE_TIMEOUT_S=60
TELEGRAM_POOL_TIMEOUT_S=60

# Proxy settings (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# ALL_PROXY=http://proxy.example.com:8080
